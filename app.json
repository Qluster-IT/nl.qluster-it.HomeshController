{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "nl.qluster-it.HominyController",
  "version": "0.0.2",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Hominy Controller"
  },
  "description": {
    "en": "Control other (satellite) Homey's"
  },
  "category": [
    "appliances"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Arie J. Godschalk",
    "email": "arie@qluster-it.nl"
  },
  "support": "mailto:arie@qluster-it.nl",
  "flow": {
    "actions": [
      {
        "id": "action_satellite_play_url",
        "title": {
          "en": "Play URL",
          "nl": "Speel URL"
        },
        "titleFormatted": {
          "en": "Play [[url]]",
          "nl": "Speel [[url]]"
        },
        "hint": "URL",
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=satellite"
          },
          {
            "name": "url",
            "type": "text",
            "placeholder": "Url"
          }
        ]
      },
      {
        "id": "action__satellite_startflow__text1_number1_boolean1",
        "title": {
          "en": "Start Flowcard",
          "nl": "Start Flowkaart"
        },
        "titleFormatted": {
          "en": "Start [[name]]/[[namebytag]] with ([[text1]], [[number1]], [[boolean1]]) and Set Wait to Finish to [[waittofinish]]",
          "nl": "Start [[name]]/[[namebytag]] met ([[text1]], [[number1]], [[boolean1]]) en zet wacht op gereed op [[waittofinish]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=satellite"
          },
          {
            "type": "autocomplete",
            "required": false,
            "name": "name",
            "placeholder": {
              "en": "Type or select a trigger name",
              "nl": "Type of kies een trigger naam"
            },
            "title": {
              "en": "Triggername",
              "nl": "Triggernaam"
            }
          },
          {
            "type": "text",
            "required": false,
            "name": "namebytag",
            "placeholder": {
              "en": "Or use a Tag or text as name",
              "nl": "Of gebruik een Tag of tekst als naam"
            },
            "title": {
              "en": "Tag",
              "nl": "Tag"
            }
          },
          {
            "type": "text",
            "name": "text1",
            "placeholder": {
              "en": "Text 1",
              "nl": "Tekst 1"
            },
            "required": false
          },
          {
            "type": "number",
            "name": "number1",
            "placeholder": {
              "en": "Number 1",
              "nl": "Nummer 1"
            },
            "required": false
          },
          {
            "type": "checkbox",
            "name": "boolean1",
            "placeholder": {
              "en": "Yes/No 1",
              "nl": "Ja/Nee 1"
            },
            "required": false
          },
          {
            "type": "checkbox",
            "name": "waittofinish",
            "placeholder": {
              "en": "Yes",
              "nl": "Ja"
            },
            "required": false
          }
        ],
        "tokensnotinuse": [
          {
            "type": "string",
            "name": "text1",
            "title": {
              "en": "Text 1",
              "nl": "Tekst 1"
            }
          },
          {
            "type": "number",
            "name": "number1",
            "title": {
              "en": "Number 1",
              "nl": "Nummer 1"
            }
          },
          {
            "type": "boolean",
            "name": "boolean1",
            "title": {
              "en": "Yes/No 1",
              "nl": "Ja/Nee 1"
            }
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Homey (Satellite)"
      },
      "class": "other",
      "capabilities": [],
      "platforms": [
        "local"
      ],
      "images": {
        "small": "/drivers/satellite/assets/images/small.png",
        "large": "/drivers/satellite/assets/images/large.png",
        "xlarge": "/drivers/satellite/assets/images/xlarge.png"
      },
      "connectivity": [
        "lan"
      ],
      "discovery": "Satellite_mDNS-SD",
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "pincode"
          }
        },
        {
          "id": "pincode",
          "template": "pincode",
          "options": {
            "title": "Enter pincode:",
            "hint": "Enter the Homey Satellite's pincode",
            "type": "number",
            "length": 4
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "repair": [
        {
          "id": "pincode",
          "template": "pincode",
          "options": {
            "title": "Enter pincode:",
            "hint": "Enter the Homey Satellite's pincode",
            "type": "number",
            "length": 4
          }
        }
      ],
      "id": "satellite"
    }
  ],
  "discovery": {
    "Satellite_mDNS-SD": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "_homey",
        "protocol": "tcp"
      },
      "id": "{{txt.id}}"
    }
  }
}