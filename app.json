{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "nl.qluster-it.HominyController",
  "version": "0.0.1",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Hominy Controller"
  },
  "description": {
    "en": "Control other (satellite) Homey's"
  },
  "category": [
    "appliances"
  ],
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Arie J. Godschalk",
    "email": "arie@qluster-it.nl"
  },
  "support": "mailto:arie@qluster-it.nl",
  "drivers": [
    {
      "name": {
        "en": "Homey (Satellite)"
      },
      "class": "other",
      "capabilities": [],
      "platforms": [
        "local"
      ],
      "images": {
        "small": "/drivers/homey-satellite/assets/images/small.png",
        "large": "/drivers/homey-satellite/assets/images/large.png",
        "xlarge": "/drivers/homey-satellite/assets/images/xlarge.png"
      },
      "connectivity": [
        "lan"
      ],
      "discovery": "Satellite_mDNS-SD",
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "pincode"
          }
        },
        {
          "id": "pincode",
          "template": "pincode",
          "options": {
            "title": "Enter pincode:",
            "hint": "Enter the Homey Satellite's pincode",
            "type": "number",
            "length": 4
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "id": "homey-satellite"
    }
  ],
  "discovery": {
    "Satellite_mDNS-SD": {
      "type": "mdns-sd",
      "mdns-sd": {
        "name": "_homey",
        "protocol": "tcp"
      },
      "id": "{{txt.id}}"
    }
  }
}