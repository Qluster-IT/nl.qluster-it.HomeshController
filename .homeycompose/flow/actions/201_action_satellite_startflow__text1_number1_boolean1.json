{
    "id": "action__satellite_startflow__text1_number1_boolean1",
    "title": {
        "en": "Start Flowcard",
        "nl": "Start Flowkaart"
    },
    "titleFormatted": {
        "en": "Start [[name]]/[[namebytag]] with ([[text1]], [[number1]], [[boolean1]]) and [[waittofinish]]",
        "nl": "Start [[name]]/[[namebytag]] met ([[text1]], [[number1]], [[boolean1]]) en [[waittofinish]]"
    },
    "args": [
        {
            "name": "device",
            "type": "device",
            "filter": "driver_id=satellite"
        },
        {
            "type": "autocomplete",
            "required":false,
            "name": "name",
            "placeholder": {
                "en": "Type or select a trigger name",
                "nl": "Type of kies een trigger naam"
            },
            "title": {
                "en": "Triggername",
                "nl": "Triggernaam"
            }
        },
        {
            "type": "text",
            "required":false,
            "name": "namebytag",
            "placeholder": {
                "en": "Or use a Tag or text as name",
                "nl": "Of gebruik een Tag of tekst als naam"
            },
            "title": {
                "en": "Tag",
                "nl": "Tag"
            }
        },
        {
            "type": "text",
            "name": "text1",
            "placeholder": {
                "en": "Text 1",
                "nl": "Tekst 1"
            },
            "required":false
        },
        {
            "type": "number",
            "name": "number1",
            "placeholder": {
                "en": "Number 1",
                "nl": "Nummer 1"
            },
            "required":false
        },        
        {
            "type": "checkbox",
            "name": "boolean1",
            "placeholder": {
                "en": "Yes/No 1",
                "nl": "Ja/Nee 1"
            },
            "required":false
        },        
        {
            "type": "dropdown",
            "name": "waittofinish",
            "placeholder": {
                "en": "wait to finish",
                "nl": "wacht tot gereed"
            },
            "title": {
              "en": "wait to finish",
              "nl": "wacht tot gereed"
            },
            "required":false,            
            "values": [
                {
                  "id": "waittofinish",
                  "label": {
                    "en": "wait to finish",
                    "nl": "wacht tot gereed"
                  }
                },
                {
                  "id": "nothing",
                  "label": {
                    "en": "nothing else",
                    "nl": "verder niks"
                  }
                }
              ]
        }
    ]
}